    {
      "name": "03. Transactions",
      "item": [
        {
          "name": "3.1 Add Income Transaction (Salary)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Monthly Salary\",\n  \"amount\": 4500,\n  \"type\": \"income\",\n  \"category\": \"Salary\",\n  \"date\": \"2026-09-01\",\n  \"notes\": \"Direct company deposit\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('transaction_id', jsonData.data._id);",
                  "    console.log('✅ Income Transaction ID saved:', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.2 Add Expense Transaction (Groceries)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Weekly Groceries\",\n  \"amount\": 85.50,\n  \"type\": \"expense\",\n  \"category\": \"Food & Dining\",\n  \"date\": \"2026-09-15\",\n  \"notes\": \"Fresh fruits, vegetables, and milk\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('transaction_id', jsonData.data._id);",
                  "    console.log('✅ Expense Transaction ID saved:', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.3 List All Transactions (Pagination & Sorting)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions?limit=10&page=1&sortBy=date&sortOrder=desc",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "page", "value": "1" },
                { "key": "sortBy", "value": "date" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "3.4 Get Monthly Summary (Analytics)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions/monthly-summary?year=2026&month=9",
              "host": ["{{base_url}}"],
              "path": ["transactions", "monthly-summary"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "month", "value": "9" }
              ]
            }
          }
        },
        {
          "name": "3.5 Delete Transaction",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions/{{transaction_id}}",
              "host": ["{{base_url}}"],
              "path": ["transactions", "{{transaction_id}}"]
            }
          }
        }
      ]
