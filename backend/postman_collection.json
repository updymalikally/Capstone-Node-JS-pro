                  "    pm.collectionVariables.set('admin_token', jsonData.data.token);",
                  "    console.log('✅ Admin Token automatically saved:', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.4 Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "1.5 Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
